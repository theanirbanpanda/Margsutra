rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /trips/{tripId} {
      // Public read is intentional: a trekker looks up a trip by its join
      // code before they have any session at all (join-by-code happens
      // pre-authentication by design, not a workaround).
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sos_events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    match /sos_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
    }

    match /weather_history/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // written only by Cloud Functions
    }

    match /weather_forecasts/{nodeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /safety_protocols/{protocolId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /bluetooth_devices/{deviceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
