# ─── Dependencies ────────────────────────────────────────────────────────────
# 464 MB of packages, reproduced by `npm ci` — never commit these.
node_modules/
.pnp
.pnp.js
.yarn/
jspm_packages/

# ─── Build output ────────────────────────────────────────────────────────────
# dist/ is committed ON PURPOSE: the Oracle installer and Firebase Hosting serve
# the built bundles directly from the repo. Do not add dist/ here.
.vite/
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
*.tsbuildinfo

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/

# ─── Environment files and secrets ───────────────────────────────────────────
# Everything here is private. The public Firebase *web* config and the
# build-time production files are re-allowed at the bottom of this block.
.env
.env.*
.env.local
.env.*.local
backend/.env
tracking/server/.env

# Private keys / certificates / service accounts
serviceAccountKey.json
*serviceAccount*.json
*.pem
*.p12
*.pfx
*.key
*.jks
*.keystore
id_rsa
id_ed25519
id_dsa

# Re-allowed: templates and public, secret-free config
!.env.example
!admin-app/.env
!user-app/.env
!admin-app/.env.production
!user-app/.env.production

# ─── Firebase emulator / CLI artefacts ───────────────────────────────────────
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebase/
emulator-data/
firebase-export-*/
.firebaserc.local

# ─── Testing and coverage ────────────────────────────────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/

# ─── Python (helper scripts) ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ─── Local data / uploads ────────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db

# ─── Operating system files ──────────────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes
.fseventsd
Thumbs.db
desktop.ini

# ─── Editors ─────────────────────────────────────────────────────────────────
# The two committed .vscode files (settings, C/C++ config) stay tracked;
# anything else in there is personal.
.vscode/*
!.vscode/settings.json
!.vscode/c_cpp_properties.json
.idea/
*.swp
*.swo
*~
