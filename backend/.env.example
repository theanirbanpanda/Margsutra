PORT=5050
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175
JWT_SECRET=your-random-jwt-secret-at-least-32-chars

# Firebase credentials — pick ONE of these.
#
# 1. Local development: path to the key file. Never commit the key itself.
FIREBASE_SERVICE_ACCOUNT_PATH=../serviceAccountKey.json
#
# 2. PaaS host (Render, Railway, Fly): paste the key JSON into a secret env var.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
#
# 3. GCP runtimes (Cloud Run, App Engine, GCE, GKE): leave both unset and let
#    firebase-admin use Application Default Credentials from the attached
#    service account. Set the project only if the runtime does not inject it.
# GOOGLE_CLOUD_PROJECT=coordage-416a1

# Optional — defaults to <project>.firebasestorage.app
# FIREBASE_STORAGE_BUCKET=coordage-416a1.firebasestorage.app
