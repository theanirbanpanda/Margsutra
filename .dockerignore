# Build context for deploy/docker/Dockerfile.
# Keep it small, and never let a credential into the image.

# ── not needed to build or run ───────────────────────────────────────────────
.git
.gitignore
.gitattributes
node_modules
**/node_modules
**/dist
firmware
prototypes
deploy/oracle
LOCAL_DEV.md
.vscode
.idea

# ── OS / editor junk ─────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
**/._*
**/*.log
**/*.swp

# ── secrets (mounted at runtime, never baked in) ─────────────────────────────
serviceAccountKey.json
*serviceAccount*.json
backend/.env
tracking/server/.env

# Note: admin-app/.env, user-app/.env and their .env.production files are NOT
# excluded on purpose — they hold the public Firebase web config that Vite
# needs at build time.
