# Local development against the Firestore emulator.
# The API (npm run dev:local) is started with FIRESTORE_EMULATOR_HOST, so the
# frontends must use the emulator too or the two halves disagree.
# Remove this file (or comment the two lines) to talk to production Firebase.
VITE_FIREBASE_PROJECT_ID=demo-margsutra
VITE_USE_FIRESTORE_EMULATOR=true
